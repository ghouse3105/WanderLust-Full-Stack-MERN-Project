<%- layout("./layouts/boilerplate")%>

<h3>&nbsp;&nbsp;Create New  Listing :</h3>
<hr>
    <div class="row">
        <div class="col-8 offset-2">
    <form method="POST" action="/listings" class="needs-validation" novalidate >
        <div class="mb-3">
            <label for="title" class="form-label"><b>Title:</b></label>
        <input type="text" placeholder="enter catchy title " name="listing[title]" class="form-control" required/>
        <div class="invalid-feedback"> Plsease enter the title</div>
        </div>
        
        <div class="mb-3">
              <label for="description" class="form-label"><b>Description:</b></label>
            <textarea placeholder="enter decription " name="listing[description]" class="form-control" required></textarea>
            <div class="invalid-feedback"> please enter description</div>
        </div>
        <div class="mb-3">
              <label for="image" class="form-label"><b>Image Link/url:</b></label>
             <input type="text" placeholder="enter image url/Link " name="listing[iamge]" class="form-control">
        </div>
        <!-- <div class="mb-3">
              <label for="image" class="form-label"><b>Image Link/url:</b></label>
             <input type="file" name="listing[iamge]" class="form-control">
        </div> -->
        <div class="mb-3">
             <label for="price" class="form-label" ><b>price:</b></label>
            <input type="number" placeholder="1900 " name="listing[price]" class="form-control" required/>
            <div class="invalid-feedback"> please enter valid price</div>
        </div>
        <div class="mb-3">
              <label for="location" class="form-label"><b>Location:</b></label>
             <input type="text" placeholder="Hyd , umdanagar " name=" listing[location]" class="form-control" required >
             <div class="invalid-feedback"> location is must</div>
        </div>
       <div class="mb-3">
        <label for="Country" class="form-label"><b>Country:</b></label>
         <input type="text" placeholder="India " name="listing[country]" class="form-control" required/>
         <div class="invalid-feedback">Enter the country</div>
       </div>      
         <br><br>
        <button class="btn btn-dark add-btn">Add</button>
    </form>
    </div>
</div>

