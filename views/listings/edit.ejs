<%- layout("./layouts/boilerplate")%>

<body>
    <h3>&nbsp;&nbsp;&nbsp;Edit your Details:</h3>
<hr>
    <div class="row mt-3" >
        <div class="col-8 offset-2">
    <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" class="needs-validation" novalidate>
        <div class="mb-3">
              <label for="title" class="form-label"><b>Title:</b></label> 
             <input type="text" value="<%=listing.title%>"  name="listing[title]" class="form-control" required></div>
             <div class="invalid-feedback"> enter the <title></title></div>
    <div class="mb-3">
         <label for="description" class="form-label"><b>Description:</b></label> 
        <textarea value="<%=listing.description%>"  name="listing[description]"  class="form-control" required></textarea>
        <div class="invalid-feedback"> description is sure</div>
    </div>
    <div class="mb-3">
        <label for="image" class="form-label"><b>image Link/url:</b></label> 
         <input type="text" value="<%=listing.image%>"  name="listing[iamge]"  class="form-control"  required>
         <div class="invalid-feedback">provide the image link</div>

    </div>
    <div class="mb-3">
          <label for="price" class="form-label"><b>price:</b></label> 
        <input type="number" value="<%=listing.price%>"  name="listing[price]"  class="form-control" required>
        <div class="invalid-feedback"> enter the price</div>
    </div>
    <div class="mb-3">
        <label for="location" class="form-label"><b>location:</b></label> 
          <input type="text" value="<%=listing.location%>"  name=" listing[location]" class="form-control" required>
          <div class="invalid-feedback"> enter the location</div>
    </div>
        <div class="mb-3" >
            <label for="country" class="form-label"><b>country:</b></label> 
            <input type="text" value="<%=listing.country%>"  name="listing[country]" class="form-control" required>
            <div class="invalid-feedback"> country is must</div>
        </div>
        <br><br>
        <button class="btn btn-dark edit-btn">Edit</button>
    </form>
    </div>
    </div> 
