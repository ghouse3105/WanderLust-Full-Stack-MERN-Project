<%- layout("./layouts/boilerplate")%>

<h2 class="col-6 offset-3 ">Signup for WanderLust</h2>

 <div class="row mb-3">
    <div class="col-6  offset-3">
        <form action="/signup" method="POST" class="needs-validation"  novalidate>
            <div class="mb-3">
            <label for="username" class="form-label"><b>username:</b></label>
        <input type="text" name="username" id="username" class="form-control" required/>
        <div class="invalid-feedback"> Plsease enter the username</div>
        </div>

            
            <div class="mb-3">
            <label for="email" class="form-label"><b>email:</b></label>
        <input type="email" name="email" id="email" class="form-control" required/>
        <div class="invalid-feedback"> Plsease enter the email</div>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label"><b>password:</b></label>
        <input type="password" name="password" id="password" class="form-control" required/>
        <div class="invalid-feedback"> Plsease enter the password</div>
        </div>
        <button class="btn btn-success">Signup</button>
        </form>

    </div>
 </div>